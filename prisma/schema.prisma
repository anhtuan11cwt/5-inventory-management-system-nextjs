generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                 String    @id @default(cuid())
  name               String
  slug               String    @unique
  industry           String?
  country            String?
  state              String?
  currency           String?
  timeZone           String?
  inventoryStartDate DateTime?
  fiscalYear         String?
  address            String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  users   User[]
  roles   Role[]
  invites Invite[]

  @@map("organizations")
}

model Role {
  id             String       @id @default(cuid())
  name           String
  permissions    String[]
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  users   User[]
  invites Invite[]

  @@unique([organizationId, name])
  @@map("roles")
}

model Invite {
  id             String       @id @default(cuid())
  email          String       @unique
  status         Boolean      @default(false)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roleId         String
  role           Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@map("invites")
}

model User {
  id               String       @id @default(cuid())
  name             String
  email            String       @unique
  password         String
  isVerified       Boolean      @default(false)
  token            String?
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationName String
  roleId           String
  role             Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@map("users")
}
